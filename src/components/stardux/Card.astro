---
interface Props {
  icon?: string;
  title: string;
}

const { title } = Astro.props;
---

<article
  style="
    background: red !important;
    border: 5px solid lime !important;
    border-radius: 30px !important;
    padding: 2rem !important;
    color: white !important;
  "
>
  <h2>{title}</h2>

  <div>
    <slot />
  </div>
</article>